//===========================================================================
// parameters above are 
//===========================================================================

0.24        == Yp
2.725       == T0

0.26        == Omega_m (= Omega_cdm+Omega_b)
0.044       == Omega_b
0.0         == Omega_L (if <= 0 --> will be computed)
0.0         == Omega_K

0.71        == h100
3.04        == N_eff
1.14        == Recfast fudge factor

1.0e-24     == f_ann in eV s^-1
1           == include Chluba & Thomas 2010 correction function

3.0         == B0 in nG
-2.9        == nB
1           == decaying magnetic turbulence on / off
0           == ambipolar diffusion on / off

//===========================================================================
//===========================================================================
